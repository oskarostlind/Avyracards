#!/bin/sh
# Auto-bump iOS build number on push, then push the bump in the same run.
# After a successful auto-push we exit 1 to stop git from running a duplicate push
# (which would fail with "expected X but remote is at Y").

remote="$1"
url="$2"
BUMP_MARKER="chore(ios): auto-bump build"

if [ "$AVYRA_IOS_BUMP_PUSH" = "1" ]; then
  exit 0
fi

last_msg=$(git log -1 --pretty=%s 2>/dev/null)
case "$last_msg" in
  "$BUMP_MARKER"*)
    exit 0
    ;;
esac

out=$(node scripts/bump-ios-build.mjs)
status=$?
if [ $status -ne 0 ]; then
  echo "$out"
  echo "[pre-push] iOS build bump failed; aborting push."
  exit 1
fi
echo "$out"

new=$(echo "$out" | sed -n 's/.*-> \([0-9]*\).*/\1/p')

git commit ios/App/App.xcodeproj/project.pbxproj -m "$BUMP_MARKER to ${new}" >/dev/null 2>&1

echo ""
echo "[pre-push] iOS build bumped to ${new} — pushing automatically..."

pushed=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  AVYRA_IOS_BUMP_PUSH=1 git push "$remote" "${local_ref}:${remote_ref}"
  push_status=$?
  if [ $push_status -ne 0 ]; then
    exit $push_status
  fi
  pushed=1
done

if [ "$pushed" -eq 0 ]; then
  branch=$(git rev-parse --abbrev-ref HEAD)
  AVYRA_IOS_BUMP_PUSH=1 git push "$remote" "HEAD:${branch}"
  push_status=$?
  if [ $push_status -ne 0 ]; then
    exit $push_status
  fi
  echo ""
  echo "[pre-push] Push completed successfully (build ${new})."
  exit 1
fi

echo ""
echo "[pre-push] Push completed successfully (build ${new})."
exit 1
