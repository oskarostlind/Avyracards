generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  username      String    @unique
  bio           String?
  theme         String    @default("default")
  font          String    @default("inter")
  avatarUrl     String?
  backgroundUrl String?
  isPremium     Boolean   @default(false)
  
  // Stripe Customer ID (bra för framtiden vid recurring subs)
  stripeCustomerId String? 

  emailVerified     DateTime?
  verificationToken String?

  phoneNumber  String?
  contactEmail String?

  redirectEnabled Boolean @default(true)

  links        Link[]
  
  // Kort som användaren har claimat/äger
  cards        Card[]

  // RELATION TILL STATISTIK (LÖSER FELET)
  analyticsEvents AnalyticsEvent[]

  profileMode ProfileMode @default(SOCIAL)

  // Hero
  jobTitle         String?
  companyName      String?
  location         String?
  businessHeadline String?

  // Kontaktblock
  businessPhone String?
  businessEmail String?
  vcardUrl      String?
  bookingUrl    String?

  // Nyckelinfo / chips
  expertiseTags  String?
  languages      String?
  businessRegion String?

  // Företagssektion
  companyLogoUrl       String?
  companyDescription String?
  companyWebsite       String?
  careerPageUrl        String?
}

enum ProfileMode {
  SOCIAL
  BUSINESS
}

model Link {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATION TILL STATISTIK (LÖSER FELET)
  analyticsEvents AnalyticsEvent[]

  @@index([userId, order])
}

// --- NYA TABELLER FÖR KÖPFLÖDET ---

model Order {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  stripeSessionId String?     @unique
  amountTotal     Int         // I öre (cent)
  currency        String      @default("sek")
  
  status          OrderStatus @default(PENDING)
  
  customerEmail   String
  customerType    CustomerType @default(PRIVATE)
  companyName     String?     // Endast om företag
  
  quantity        Int         @default(1)
  
  // En order kan innehålla flera kort-slots
  cards           Card[]
}

model Card {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  
  // Unik kod som trycks på kortet (t.ex. "X9F2P1")
  cardCode        String      @unique
  
  // Hemlig token för att claima kortet (används i URL vid första scan)
  claimToken      String      @unique
  
  // Status på kortet
  status          CardStatus @default(UNCLAIMED)
  
  claimedAt       DateTime?
  
  // Koppling till Order (ursprunget)
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  
  // Koppling till User (när det är claimat)
  assignedUserId String?
  user           User?       @relation(fields: [assignedUserId], references: [id])
  
  // Metadata om själva kortet (från produktbyggaren)
  material        String?     // plast, metall
  designTemplate String?     // minimal, full-logo
  colorOption     String?     // black, white, gold
  printFileUrl    String?     // URL till uppladdad logga
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
}

enum CustomerType {
  PRIVATE
  COMPANY
}

enum CardStatus {
  UNCLAIMED
  CLAIMED
  DISABLED
  LOST
}


// --- NY TABELL FÖR STATISTIK ---

model AnalyticsEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Vem äger profilen som besöktes?
  profileOwnerId String
  profileOwner   User   @relation(fields: [profileOwnerId], references: [id], onDelete: Cascade)

  // Typ av händelse
  type EventType // VIEW eller CLICK

  // Om det var ett klick, vilken länk?
  linkId String?
  link   Link?   @relation(fields: [linkId], references: [id], onDelete: SetNull)

  // Data om besökaren
  referrer String? // Vart kom de ifrån? (t.ex. instagram.com)
  country  String? // (Kan läggas till senare via IP-uppslag)
  device   String? // mobile/desktop
  
  @@index([profileOwnerId])
  @@index([createdAt])
}

enum EventType {
  VIEW
  CLICK
}