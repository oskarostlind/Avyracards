generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  username      String    @unique
  bio           String?

  // Grundläggande utseende
  font          String    @default("inter")
  avatarUrl     String?
  backgroundUrl String?
  isPremium     Boolean   @default(false)
  
  stripeCustomerId String? 

  emailVerified     DateTime?
  verificationToken String?

  phoneNumber  String?
  contactEmail String?

  redirectEnabled Boolean @default(true)

  links         Link[]
  cards         Card[]
  analyticsEvents AnalyticsEvent[]

  profileMode ProfileMode @default(SOCIAL)

  // Hero / Business
  jobTitle         String?
  companyName      String?
  location         String?
  businessHeadline String?

  // Kontaktblock
  businessPhone String?
  businessEmail String?
  vcardUrl      String?
  bookingUrl    String?

  // Nyckelinfo
  expertiseTags  String?
  languages      String?
  businessRegion String?

  // Företagssektion
  companyLogoUrl     String?
  companyDescription String?
  companyWebsite     String?
  careerPageUrl      String?

  marketingConsent Boolean @default(false)
  productUpdates   Boolean @default(true)
  hideFromSearch   Boolean @default(false)

  // THEME ENGINE
  theme String @default("default")
  themeSettings Json?  // Här sparas hela CustomThemeSettings-objektet

  role Role @default(USER)
}

enum ProfileMode {
  SOCIAL
  BUSINESS
}

enum Role {
  USER
  ADMIN
}

model Link {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyticsEvents AnalyticsEvent[]

  @@index([userId, order])
}

model Order {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  stripeSessionId String?     @unique
  amountTotal     Int         
  currency        String      @default("sek")
  
  status          OrderStatus @default(PENDING)
  
  customerEmail   String
  customerType    CustomerType @default(PRIVATE)
  companyName     String?     
  
  quantity        Int         @default(1)
  
  cards           Card[]
}

model Card {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  
  cardCode        String      @unique
  claimToken      String      @unique
  
  status          CardStatus @default(UNCLAIMED)
  
  claimedAt       DateTime?
  
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  
  assignedUserId String?
  user           User?        @relation(fields: [assignedUserId], references: [id])
  
  material        String?     
  designTemplate String?     
  colorOption     String?     
  printFileUrl    String?     
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
}

enum CustomerType {
  PRIVATE
  COMPANY
}

enum CardStatus {
  UNCLAIMED
  CLAIMED
  DISABLED
  LOST
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileOwnerId String
  profileOwner   User   @relation(fields: [profileOwnerId], references: [id], onDelete: Cascade)

  type EventType 

  linkId String?
  link   Link?   @relation(fields: [linkId], references: [id], onDelete: SetNull)

  referrer String? 
  source   String? // Nytt fält: "nfc", "qr", "link", "direct"
  country  String? // Fanns innan
  city     String? // Nytt fält: "Stockholm", "New York"
  device   String? 
  
  @@index([profileOwnerId])
  @@index([createdAt])
}




enum EventType {
  VIEW
  CLICK
}




// --- PRODUKTHANTERING (PIM) ---

model Product {
  id          String   @id @default(cuid())
  name        String   
  description String?
  slug        String   @unique 
  features    String[] 
  isActive    Boolean  @default(true)
  
  variants    ProductVariant[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name          String  
  type          String  // "PHYSICAL" eller "SUBSCRIPTION"
  
  // PRIS & KAMPANJ
  price         Int     // Det aktuella priset kunden betalar (t.ex. 39900)
  compareAtPrice Int?   // Det gamla "ordinarie" priset (t.ex. 49900). Om denna finns visas REA-skylt.
  
  currency      String  @default("sek")
  stripePriceId String? 
  
  // UI & Lager
  imageUrl      String? 
  colorCode     String? 
  stock         Int     @default(100)
  isActive      Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// NY MODELL: RABATTKODER
model Discount {
  id          String    @id @default(cuid())
  code        String    @unique // T.ex. "BLACKWEEK"
  type        String    // "PERCENTAGE" eller "FIXED"
  value       Int       // 20 (för 20%) eller 10000 (för 100kr)
  
  startsAt    DateTime? // När börjar koden gälla?
  expiresAt   DateTime? // När går den ut?
  usageLimit  Int?      // Max antal gånger den får användas totalt (t.ex. 50 första kunderna)
  usedCount   Int       @default(0) // Hur många gånger har den använts?
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}